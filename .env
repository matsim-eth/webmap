# =====================================================================
# Central .env — all Docker Compose environment variables
# =====================================================================

# ── Mode ─────────────────────────────────────────────────────
# DEV_MODE=1  → seeds dev account, dev accounts can log in
# DEV_MODE=0  → production, dev accounts blocked
DEV_MODE=1
ENV=dev
PROXY_MODE=dev

# ── Auth & Token Settings ────────────────────────────────────
JWT_SECRET=UltraSecretKey
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# ── Auth Database (Postgres) ────────────────────────────────
AUTH_DB_USER=user
AUTH_DB_PASSWORD=pass
AUTH_DB_NAME=appdb

# ── Dataset Database (Postgres) ─────────────────────────────
DATASET_DB_USER=dataset_user
DATASET_DB_PASSWORD=dataset_pass
DATASET_DB_NAME=datasetdb

# ── Admin Account (seeded on startup) ───────────────────────
ADMIN_EMAIL=admin@webmap.local
ADMIN_PASSWORD=Admin!2024Secure

# ── Dev Account (seeded when DEV_MODE=1) ────────────────────
DEV_EMAIL=dev@local
DEV_PASSWORD=dev

# ── Data ────────────────────────────────────────────────────
WEBMAP_ROOT=/data/datasets/public

# ── Prod overrides (uncomment for production) ───────────────
# DEV_MODE=0
# ENV=prod
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14
# PROXY_MODE=deploy
# JWT_SECRET=<generate-a-strong-secret>
# AUTH_DB_PASSWORD=<strong-password>
# DATASET_DB_PASSWORD=<strong-password>
