# =====================================================================
# Central .env — copy this file to .env and adjust values
# =====================================================================
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiYW5kd29vIiwiYSI6ImNrMjlnYnNkdTEwMHozaG5wamJvZHJyangifQ.6M4eeri_Ubmo7NedQT7NuQ

# ── Mode ─────────────────────────────────────────────────────
# DEV_MODE=1  → seeds dev account, dev accounts can log in
# DEV_MODE=0  → production, dev accounts blocked
DEV_MODE=1
ENV=dev

# ── Auth & Token Settings ────────────────────────────────────
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# Shared secret for service-to-service /internal/* calls (auth → dataset
# backend). Defense-in-depth on top of the proxy blocking /internal/ from the
# edge. Set the same value here for all services; leave empty to disable the
# header check and rely on proxy/network isolation only.
INTERNAL_SERVICE_SECRET=change-me-internal-secret

# ── Auth Database (Postgres) ────────────────────────────────
AUTH_DB_USER=user
AUTH_DB_PASSWORD=pass
AUTH_DB_NAME=appdb

# ── Dataset Database (Postgres) ─────────────────────────────
DATASET_DB_USER=dataset_user
DATASET_DB_PASSWORD=dataset_pass
DATASET_DB_NAME=datasetdb

# ── Admin Account (seeded on startup) ───────────────────────
ADMIN_EMAIL=admin@webmap.local
ADMIN_PASSWORD=

# ── Dev Account (seeded when DEV_MODE=1) ────────────────────
DEV_EMAIL=dev@local
DEV_PASSWORD=dev

# ── Registration gates (both optional, both default OFF) ────
# 1 → new accounts must click a mailed verification link before login.
#     Without SMTP config the link is written to the auth-backend log.
REQUIRE_EMAIL_VERIFICATION=0
# 1 → new accounts must additionally be approved by an admin
#     (admin panel → Users → Approve).
REQUIRE_ADMIN_APPROVAL=0
# Public origin used in the mailed verification link:
PUBLIC_BASE_URL=http://localhost
# SMTP (leave empty to log verification links instead of mailing them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Proxy ───────────────────────────────────────────────────
# Host port the whole app is served on. Change this (not the compose
# file) when port 80 is already taken on the host — survives git pull/reset.
PROXY_PORT=80

# ── Data ────────────────────────────────────────────────────
WEBMAP_ROOT=/data/datasets/public

# ── AI query ("Ask AI" chat) ────────────────────────────────
# The floating Ask-AI button only appears when BOTH are set:
# the flag is on AND a key is present.
AI_QUERY_ENABLED=0
# LLM provider for the website agent: "gemini" (default) or "openai"
# (any OpenAI-compatible endpoint — OpenAI, Ollama, vLLM, ...).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Only for LLM_PROVIDER=openai:
#LLM_BASE_URL=http://host.docker.internal:11434/v1
#LLM_API_KEY=

# ── MCP server (AI tool access for external MCP clients) ────
# Served at <origin>/mcp (streamable HTTP). Users authenticate with
# personal API tokens created in the webmap (account menu → API tokens).
# No extra config needed — runs as part of the stack.

# ── Resource tuning (laptops) ───────────────────────────────
# Unset = DuckDB defaults (~80% of RAM, all cores) — right for a server,
# heavy on a laptop next to browser + IDE. Recommended laptop values:
#DUCKDB_MEMORY_LIMIT=4GB
#DUCKDB_THREADS=4
# Startup cache prewarm (full link_speeds scan + transit-stops build per
# dataset). 0 = off — worth it on a laptop, where the cost is paid by whatever
# you're doing right now.
#WEBMAP_PREWARM=0
# How many datasets to warm, in prewarm order (default dataset first, then
# ascending id). Unset/0 = all of them. Each is ~2 min of background CPU and
# holds its stops bundle + dashboard aggregate in RAM for the life of the
# worker (x UVICORN_WORKERS) — set 1 on a laptop to warm only the default.
#WEBMAP_PREWARM_LIMIT=1
# Traffic gate: the prewarm waits for this many seconds of no data requests
# before starting each build, giving up after MAX_WAIT so traffic can't starve
# it, and pauses YIELD seconds after each one. QUIET=0 disables the gate.
#WEBMAP_PREWARM_QUIET=3
#WEBMAP_PREWARM_MAX_WAIT=300
#WEBMAP_PREWARM_YIELD=1
# Warm a dataset the moment someone opens it, ahead of the speculative startup
# pass (and preempting it between builds). Defaults to WEBMAP_PREWARM's value.
# WARM_QUIET is that warm's traffic-gate threshold — shorter than the startup
# one because the user is actively clicking through the dataset.
#WEBMAP_WARM_ON_SWITCH=0
#WEBMAP_WARM_QUIET=1
