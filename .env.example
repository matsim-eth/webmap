# =====================================================================
# Central .env — copy this file to .env and adjust values
# =====================================================================
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiYW5kd29vIiwiYSI6ImNrMjlnYnNkdTEwMHozaG5wamJvZHJyangifQ.6M4eeri_Ubmo7NedQT7NuQ

# ── Mode ─────────────────────────────────────────────────────
# DEV_MODE=1  → seeds dev account, dev accounts can log in
# DEV_MODE=0  → production, dev accounts blocked
DEV_MODE=1
ENV=dev

# ── Auth & Token Settings ────────────────────────────────────
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# ── Auth Database (Postgres) ────────────────────────────────
AUTH_DB_USER=user
AUTH_DB_PASSWORD=pass
AUTH_DB_NAME=appdb

# ── Dataset Database (Postgres) ─────────────────────────────
DATASET_DB_USER=dataset_user
DATASET_DB_PASSWORD=dataset_pass
DATASET_DB_NAME=datasetdb

# ── Admin Account (seeded on startup) ───────────────────────
ADMIN_EMAIL=admin@webmap.local
ADMIN_PASSWORD=

# ── Dev Account (seeded when DEV_MODE=1) ────────────────────
DEV_EMAIL=dev@local
DEV_PASSWORD=dev

# ── Registration gates (both optional, both default OFF) ────
# 1 → new accounts must click a mailed verification link before login.
#     Without SMTP config the link is written to the auth-backend log.
REQUIRE_EMAIL_VERIFICATION=0
# 1 → new accounts must additionally be approved by an admin
#     (admin panel → Users → Approve).
REQUIRE_ADMIN_APPROVAL=0
# Public origin used in the mailed verification link:
PUBLIC_BASE_URL=http://localhost
# SMTP (leave empty to log verification links instead of mailing them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Data ────────────────────────────────────────────────────
WEBMAP_ROOT=/data/datasets/public

# ── Resource tuning (laptops) ───────────────────────────────
# Unset = DuckDB defaults (~80% of RAM, all cores) — right for a server,
# heavy on a laptop next to browser + IDE. Recommended laptop values:
#DUCKDB_MEMORY_LIMIT=4GB
#DUCKDB_THREADS=4
# Startup cache prewarm (full link_speeds scan per dataset). 0 = off.
#WEBMAP_PREWARM=0
